WOI_ENVIRONMENT=development
WOI_LOG_LEVEL=INFO
WOI_API_HOST=0.0.0.0
WOI_API_PORT=8000
WOI_WEB_PORT=3000
WOI_DB_POOL_SIZE=10
WOI_DB_MAX_OVERFLOW=20
WOI_DB_POOL_RECYCLE_SECONDS=1800
WOI_DB_ECHO=false
WOI_DATABASE_URL=postgresql+asyncpg://world_of_islam:change-me@postgres:5432/world_of_islam
WOI_REDIS_URL=redis://:local-redis-password@redis:6379/0
WOI_CELERY_BROKER_URL=redis://:local-redis-password@redis:6379/1
WOI_CELERY_RESULT_BACKEND=redis://:local-redis-password@redis:6379/2
WOI_S3_ENDPOINT=http://minio:9000
WOI_S3_ACCESS_KEY=world-of-islam-local
WOI_S3_SECRET_KEY=change-this-minio-secret
WOI_S3_BUCKET=world-of-islam
WOI_ALLOWED_ORIGINS=http://localhost:3000
WOI_SECRET_KEY=replace-with-at-least-32-random-characters
WOI_SESSION_COOKIE_NAME=woi_session
WOI_SESSION_TTL_SECONDS=2592000
WOI_EMAIL_VERIFICATION_TTL_SECONDS=86400
WOI_PASSWORD_RESET_TTL_SECONDS=1800
WOI_COOKIE_SECURE=false
# Scopes the session cookie to the deployment base path. Local dev serves the
# app at the origin root, so "/" is correct here. In production behind
# https://app.arfaat.com/worldofislam, set this to "/worldofislam" so the
# cookie is never sent to other apps hosted on app.arfaat.com.
WOI_COOKIE_PATH=/
# Only set this if your reverse proxy forwards the external prefix to the API
# verbatim instead of stripping it (see docs/deployment/base-path.md). Leave
# empty when the proxy strips "/worldofislam" before forwarding to this service.
WOI_ROOT_PATH=
WOI_AUTH_RATE_LIMIT=10
# The exact address of your reverse proxy container/host. NEVER "*" in
# production: a wildcard lets any client spoof X-Forwarded-For and bypass
# the IP-keyed rate limiter above. Defaults to loopback-only in the
# Dockerfile if unset, which fails closed rather than open.
WOI_FORWARDED_ALLOW_IPS=127.0.0.1

# --- AI provider (see docs/ai/provider-architecture.md) ---
# "local" only ever talks to a self-hosted Ollama instance and requires no
# API key. Never change this to reach a paid API without also reading that
# doc - "external" mode still does nothing unless WOI_EXTERNAL_AI_ENABLED
# is ALSO set, and this codebase ships no concrete paid-API implementation.
WOI_AI_MODE=local
WOI_EXTERNAL_AI_ENABLED=false
WOI_OLLAMA_BASE_URL=http://localhost:11434
WOI_OLLAMA_MODEL=llama3.1
WOI_OLLAMA_TIMEOUT_SECONDS=30

# --- Frontend (Next.js) ---
# Origin the browser calls for the API. Local dev talks to the API directly;
# in production this is the public origin the reverse proxy exposes.
NEXT_PUBLIC_WOI_API_ORIGIN=http://localhost:8000
# Deployment base path for the web app. Empty for local dev. In production:
# WOI_BASE_PATH=/worldofislam
WOI_BASE_PATH=

POSTGRES_DB=world_of_islam
POSTGRES_USER=world_of_islam
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=world-of-islam-local
MINIO_ROOT_PASSWORD=change-this-minio-secret
REDIS_PASSWORD=local-redis-password
