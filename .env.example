# =========================================================================
# Client Operations Platform — environment configuration template
# Copy to `.env` for local development. Docker Compose reads this file
# automatically. Every variable marked "REQUIRES EXTERNAL CREDENTIAL" must
# be supplied with a real value before deploying to a shared/production
# environment — the placeholder values below only work for local dev.
# =========================================================================

# ---------- General ----------
ENVIRONMENT=development
# development | test | staging | production
LOG_LEVEL=INFO
TZ=UTC

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Disable interactive OpenAPI docs when true (set true in production).
API_DOCS_DISABLED=false

# Secret used to sign short-lived tokens (email verification, password
# reset, invitations). Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# REQUIRES EXTERNAL CREDENTIAL in production (do not reuse the dev value).
APP_SECRET_KEY=dev-only-insecure-secret-change-me-00000000000000000000000000

# Session cookie configuration.
SESSION_COOKIE_NAME=cops_session
SESSION_COOKIE_SECURE=false
# true in production (requires HTTPS)
SESSION_ABSOLUTE_TTL_HOURS=12
SESSION_IDLE_TTL_MINUTES=60

# ---------- Web ----------
NEXT_PUBLIC_APP_NAME="Client Operations Platform"
# Public: the browser calls the API directly at this URL (CORS-protected,
# session-cookie-authenticated — no secrets are exposed by this value).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Server-side only — never exposed to the browser bundle. Reserved for a
# future Next.js server-side proxy/rewrite; not used by client components.
INTERNAL_API_BASE_URL=http://api:8000

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cops
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev_only
# Runtime role: used by the API/worker at request time. NOSUPERUSER, NOBYPASSRLS.
POSTGRES_RUNTIME_USER=app_runtime
POSTGRES_RUNTIME_PASSWORD=app_runtime_dev_only
# Migration role: used only by Alembic. NOSUPERUSER, BYPASSRLS.
POSTGRES_MIGRATOR_USER=app_migrator
POSTGRES_MIGRATOR_PASSWORD=app_migrator_dev_only

DATABASE_URL=postgresql+psycopg://app_runtime:app_runtime_dev_only@postgres:5432/cops
MIGRATION_DATABASE_URL=postgresql+psycopg://app_migrator:app_migrator_dev_only@postgres:5432/cops

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
RATE_LIMIT_REDIS_URL=redis://redis:6379/3

# ---------- Object storage (S3-compatible) ----------
STORAGE_BACKEND=local
# local | s3
STORAGE_LOCAL_ROOT=/data/storage
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=cops-dev
S3_REGION=us-east-1
# REQUIRES EXTERNAL CREDENTIAL in production (MinIO dev defaults below).
S3_ACCESS_KEY_ID=minio_dev_access_key
S3_SECRET_ACCESS_KEY=minio_dev_secret_key
S3_USE_PATH_STYLE=true

# ---------- Email (local dev via MailHog) ----------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM_ADDRESS=no-reply@dev.internal
EMAIL_FROM_NAME="Client Operations Platform"
# REQUIRES EXTERNAL CREDENTIAL in production: replace MailHog with a real
# transactional email provider (e.g. Amazon SES, Postmark, SendGrid) and
# set SMTP_HOST/PORT/USER/PASSWORD accordingly, or implement an
# EmailProvider adapter for the provider's API.

# ---------- Platform seed defaults (development only) ----------
SEED_PLATFORM_ADMIN_EMAIL=platform-admin@dev.internal
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe!12345
SEED_DEMO_TENANT_SLUG=rafana-advisory-demo
