# Copy to .env.local for local development.

# Recipient address for contact form submissions (defaults to hello@gridkeep.com
# via src/lib/constants.ts if unset).
CONTACT_RECIPIENT_EMAIL=hello@gridkeep.com

# Required only once real email delivery is wired up in
# src/app/api/contact/route.ts (e.g. Resend, Postmark, or SMTP credentials).
# RESEND_API_KEY=
