# =====================================================================
# GRIDKEEP local development environment template
# Copy to .env and adjust as needed. Never commit a real .env file.
# All values below are safe local-dev defaults / fictional secrets.
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gridkeep
POSTGRES_USER=gridkeep
POSTGRES_PASSWORD=gridkeep_dev_password
DATABASE_URL=postgres://gridkeep:gridkeep_dev_password@localhost:5432/gridkeep?sslmode=disable

# ---------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# Redpanda (Kafka-API compatible event streaming)
# ---------------------------------------------------------------------
KAFKA_BROKERS=localhost:19092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:18081

# ---------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# ---------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=gridkeep_dev
S3_SECRET_KEY=gridkeep_dev_secret
S3_BUCKET_ARTEFACTS=gridkeep-artefacts
S3_USE_SSL=false

# ---------------------------------------------------------------------
# Vault (development mode only - never use dev mode in production)
# ---------------------------------------------------------------------
VAULT_ADDR=http://localhost:8200
VAULT_DEV_ROOT_TOKEN=gridkeep-dev-root-token
VAULT_TOKEN=gridkeep-dev-root-token

# ---------------------------------------------------------------------
# Mailpit (local email capture - dev only, never a real SMTP relay)
# ---------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@gridkeep.local
MAIL_UI_URL=http://localhost:8025

# ---------------------------------------------------------------------
# control-api (Go)
# ---------------------------------------------------------------------
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=8080
CONTROL_API_BASE_URL=http://localhost:8080
CONTROL_API_ENV=development
SESSION_COOKIE_NAME=gridkeep_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
CORS_ALLOWED_ORIGINS=http://localhost:3000
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
STEP_UP_TTL_MINUTES=15
# 32-byte AES-256 key, base64-encoded, used to encrypt TOTP secrets at rest.
# Generate a real one with: openssl rand -base64 32
# This is a FICTIONAL placeholder for local dev only -- never reuse it.
MFA_ENCRYPTION_KEY=b8eJtndudamnEt9/ZmddKKTgRstx36yfnAIU9/x3scw=

# ---------------------------------------------------------------------
# control-api (Go) - test database (used by `go test`, see docs/testing)
# ---------------------------------------------------------------------
TEST_DATABASE_URL=postgres://gridkeep:gridkeep_dev_password@localhost:5432/gridkeep_test?sslmode=disable

# ---------------------------------------------------------------------
# policy-engine (Python) - Milestone 1 foundation only (health + scaffold)
# ---------------------------------------------------------------------
POLICY_ENGINE_HOST=0.0.0.0
POLICY_ENGINE_PORT=8090

# ---------------------------------------------------------------------
# worker (Go) - Milestone 1 foundation only
# ---------------------------------------------------------------------
WORKER_CONSUMER_GROUP=gridkeep-worker-dev

# ---------------------------------------------------------------------
# web (Next.js)
# ---------------------------------------------------------------------
NEXT_PUBLIC_CONTROL_API_URL=http://localhost:8080
