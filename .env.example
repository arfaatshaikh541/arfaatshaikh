# =====================================================================
# GRIDKEEP - root environment template for docker-compose local stack
# Copy to .env and fill in real values for local development.
# NEVER commit a real .env file.
# =====================================================================

# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- PostgreSQL ----
# Bootstrap superuser used only by the official postgres image to initialize
# the cluster. The application never connects with this role.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=gridkeep
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Runtime application role: NOBYPASSRLS, used by the API and worker for all
# normal request/task traffic. Row Level Security applies to this role.
APP_DB_USER=gridkeep_app
APP_DB_PASSWORD=gridkeep_app_dev_password

# Migration role: BYPASSRLS, used only by Alembic to manage schema. Never
# used to serve application requests.
MIGRATOR_DB_USER=gridkeep_migrator
MIGRATOR_DB_PASSWORD=gridkeep_migrator_dev_password

# Full async SQLAlchemy URL used by the API/worker at runtime (app role)
DATABASE_URL=postgresql+asyncpg://gridkeep_app:gridkeep_app_dev_password@postgres:5432/gridkeep
# Sync URL used by Alembic migrations (migrator role, bypasses RLS)
DATABASE_URL_SYNC=postgresql+psycopg://gridkeep_migrator:gridkeep_migrator_dev_password@postgres:5432/gridkeep

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- MinIO / S3-compatible object storage ----
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=gridkeep_minio
S3_SECRET_ACCESS_KEY=gridkeep_minio_dev_secret
S3_BUCKET_NAME=gridkeep-local
S3_REGION=us-east-1
S3_USE_SSL=false

# ---- Mail capture (local dev) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@gridkeep.local
SMTP_FROM_NAME=GRIDKEEP

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=replace_me_with_a_long_random_value
CSRF_SECRET=replace_me_with_a_long_random_value
# Base64-encoded 32-byte key used as the master key for envelope-encrypting
# connector/CRM credentials. Generate with:
# python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_ENCRYPTION_MASTER_KEY=replace_me_with_a_base64_32_byte_key

SESSION_COOKIE_NAME=gridkeep_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1
INVITATION_TOKEN_TTL_DAYS=7

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- API ----
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ---- Web ----
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Google Places (Milestone 3 - not used in Milestone 1) ----
GOOGLE_PLACES_API_KEY=

# ---- Rate limiting ----
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_HOUR_PER_ACCOUNT=20
