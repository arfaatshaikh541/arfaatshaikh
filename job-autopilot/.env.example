# Copy to .env (never commit .env). Values here are placeholders you must replace.
POSTGRES_PASSWORD=
# Set to false only for plain-HTTP local testing without a TLS proxy.
JOBAP_SECURE_COOKIES=true
JOBAP_LOG_LEVEL=INFO
JOBAP_SESSION_HOURS=12
JOBAP_MAX_UPLOAD_MB=10
# production | test | development. Only production can submit real applications.
JOBAP_ENVIRONMENT=production
# Public https URL of the dashboard (used in notification links), and the domain Caddy serves.
JOBAP_PUBLIC_BASE_URL=
JOBAP_DOMAIN=
# Human verification / timeouts are configured in the dashboard (Automation page).
