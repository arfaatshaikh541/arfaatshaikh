# 24/7 on a Linux server WITHOUT Docker. Install:
#   sudo useradd -m -s /bin/bash autopilot
#   sudo -iu autopilot   # then: git clone ..., python3.12 -m venv venv, pip install -e '.[embedded]',
#                        #       mkdir ~/run && cd ~/run && autopilot setup && autopilot create-admin --email you@x
#   sudo cp deploy/systemd/job-autopilot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now job-autopilot
#   journalctl -u job-autopilot -f
[Unit]
Description=Job Autopilot (web + scheduler + worker)
After=network-online.target
Wants=network-online.target

[Service]
User=autopilot
WorkingDirectory=/home/autopilot/run
ExecStart=/home/autopilot/job-autopilot/venv/bin/autopilot run --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/autopilot/run

[Install]
WantedBy=multi-user.target
