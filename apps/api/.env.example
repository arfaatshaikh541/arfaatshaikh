# Copy to .env for local development. Do not commit real secrets.

ENVIRONMENT=local
APP_NAME=LeadFlow
API_PREFIX=/api

# Postgres
DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow

# Redis (broker + cache)
REDIS_URL=redis://localhost:6379/0

# Auth secrets - MUST be overridden with high-entropy values outside local/test.
# generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=local-only-insecure-secret-key-change-me
FIELD_ENCRYPTION_KEY=local-only-insecure-32-byte-key!!

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Email (SMTP - Mailhog locally captures everything, no real send)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM_ADDRESS=no-reply@leadflow-demo.io
EMAIL_FROM_NAME=LeadFlow

# Frontend base URL, used to build links in emails
WEB_BASE_URL=http://localhost:3000

# Object storage (S3-compatible). Local dev uses the filesystem adapter.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=me-central-1
