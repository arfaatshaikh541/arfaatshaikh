# Local (non-Docker) development environment for apps/api.
# Copy to .env and adjust. Never commit a real .env file.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Point at a locally running PostgreSQL (see docs/database or run via
# infrastructure/scripts/setup-local-db.sh) with the migrator/app role
# split described in docs/architecture.
DATABASE_URL=postgresql+asyncpg://gridkeep_app:gridkeep_app_dev_password@localhost:5432/gridkeep
DATABASE_URL_SYNC=postgresql+psycopg://gridkeep_migrator:gridkeep_migrator_dev_password@localhost:5432/gridkeep

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SMTP_HOST=localhost
SMTP_PORT=1025

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=replace_me_with_a_long_random_value
CSRF_SECRET=replace_me_with_a_long_random_value
CREDENTIAL_ENCRYPTION_MASTER_KEY=replace_me_with_a_base64_32_byte_key

SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

API_BASE_URL=http://localhost:8000
