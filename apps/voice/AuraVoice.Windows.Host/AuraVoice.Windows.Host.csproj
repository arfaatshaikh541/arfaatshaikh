<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The actual runnable voice assistant: the composition root that wires
    the mic, VAD, wake word, STT, reasoning, TTS, and barge-in pipeline
    together into a program a person can start. net8.0-windows without
    UseWPF/UseWindowsForms builds fine on Linux (same reasoning as
    AuraVoice.Windows's own csproj), since only the Windows Desktop SDK
    targets, pulled in by UseWPF/UseWindowsForms, require an actual
    Windows host to resolve. Running it (opening a real microphone,
    producing audible speech) requires Windows and has not been done here.
    See apps/voice/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AuraVoice.Windows.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuraVoice.Windows\AuraVoice.Windows.csproj" />
    <ProjectReference Include="..\AuraVoice.Windows.Speech\AuraVoice.Windows.Speech.csproj" />
    <ProjectReference Include="..\..\windows\AuraShell.Core\AuraShell.Core.csproj" />
  </ItemGroup>

</Project>
