<Window x:Class="AuraShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURA" Height="720" Width="1100"
        Background="#0A0A0C"
        WindowStartupLocation="CenterScreen">
    <!--
        The single window this application shows. Its content is never a
        fixed dashboard — it is entirely driven by
        InterfaceShellViewModel.Mode (see MainWindow.xaml.cs's
        ApplyView), starting at Booting on every launch and swapping
        among AuthenticationView, VoiceModeView, BackendChallengeView,
        and BackendModeView as the owner authenticates, speaks, and
        (only through a real re-authenticated hotkey press) opens and
        leaves Backend Mode.
    -->
    <Grid>
        <ContentControl x:Name="RootContent" />
    </Grid>
</Window>
