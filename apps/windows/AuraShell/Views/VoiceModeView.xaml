<UserControl x:Class="AuraShell.Views.VoiceModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The real voice-first operating surface: a single central visual
        whose color and glow reflect VoiceModeViewModel.State exactly —
        driven by the real /voice/state/stream push from aura_core (see
        VoiceModeViewModel), never a decorative loop and never polled.
        Deliberately minimal: no sidebar, no transcript, no tables, no
        chat history — this is what the owner sees while simply talking
        to AURA. Backend Mode (a different view entirely, reached only
        through the hotkey + PIN challenge) is where the dashboard lives.
    -->
    <Grid Background="#000000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse x:Name="Orb" Width="200" Height="200" Fill="#3A6EA5">
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="OrbGlow" Color="#3A6EA5" BlurRadius="70" ShadowDepth="0" Opacity="0.85" />
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock x:Name="StateText" Foreground="#9A9AA5" FontSize="16" HorizontalAlignment="Center" Margin="0,28,0,0" />
            <ToggleButton x:Name="MuteToggle" Content="Mute microphone" HorizontalAlignment="Center" Margin="0,28,0,0"
                          Padding="12,6" Checked="OnMuteChecked" Unchecked="OnMuteUnchecked" />
        </StackPanel>
    </Grid>
</UserControl>
