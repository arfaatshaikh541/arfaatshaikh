<Window x:Class="AuraShell.Views.OwnerPresenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURA" Width="420" Height="260"
        Background="#0A0A0C"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <!--
        The real interactive owner-presence prompt (see
        WindowsOwnerPresenceVerifier): asks for the CURRENT Windows
        account's own password and verifies it via LogonUser. Shown as a
        real modal Window (ShowDialog), not a UserControl swapped into
        the main shell, because it must block startup until answered or
        explicitly cancelled — there is no path around it back into
        AuthenticationView's device-token check.
    -->
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Confirm it's you" Foreground="#E6E6EA" FontSize="20" FontWeight="Light"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock x:Name="AccountText" Foreground="#9A9AA5" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,0,0,20" />
            <PasswordBox x:Name="PasswordBox" Padding="10" FontSize="18" />
            <TextBlock x:Name="ErrorText" Foreground="#E05252" FontSize="13" Margin="0,12,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="OkButton" Content="Continue" Padding="18,8" Click="OnOkClick" IsDefault="True" />
                <Button Content="Cancel" Padding="18,8" Margin="12,0,0,0" Click="OnCancelClick" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
