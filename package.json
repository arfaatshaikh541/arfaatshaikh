{
  "name": "world-of-islam",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev:web": "pnpm --filter @world-of-islam/web dev",
    "build:web": "pnpm --filter @world-of-islam/web build",
    "lint:web": "pnpm --filter @world-of-islam/web lint",
    "typecheck:web": "pnpm --filter @world-of-islam/web typecheck",
    "test:web": "pnpm --filter @world-of-islam/web test"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "nanoid": ">=3.3.18",
      "sharp": ">=0.35.4",
      "brace-expansion@<2": ">=1.1.21 <2",
      "brace-expansion@>=5": ">=5.0.12",
      "js-yaml@>=4 <4.3.2": ">=4.3.2"
    }
  }
}
