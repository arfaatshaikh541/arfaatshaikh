[Unit]
Description=World of Islam Web (Next.js standalone server)
After=network.target woi-api.service
Wants=woi-api.service

[Service]
Type=simple
User=woi
Group=woi
# apps/web/next.config.ts sets outputFileTracingRoot to the monorepo root,
# so "node apps/web/server.js" must be run from the copied
# .next/standalone directory's root (see docs/deployment/ionos-vps.md step 5),
# not from apps/web itself.
WorkingDirectory=/opt/world-of-islam/web-standalone
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node apps/web/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/world-of-islam/web-standalone

[Install]
WantedBy=multi-user.target
