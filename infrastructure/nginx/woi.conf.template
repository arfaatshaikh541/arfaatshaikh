# Rendered by the nginx image from environment variables (WOI_PUBLIC_HOST, WOI_BASE_PATH).
# Public URL: https://${WOI_PUBLIC_HOST}${WOI_BASE_PATH}   e.g. https://app.arfaat.com/worldofislam
limit_req_status 429;
limit_req_zone $binary_remote_addr zone=woi_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=woi_api:10m rate=20r/s;

server {
    listen 80;
    server_name ${WOI_PUBLIC_HOST};
    server_tokens off;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }  # standard ports 80 -> 443
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${WOI_PUBLIC_HOST};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${WOI_PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${WOI_PUBLIC_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    client_max_body_size 10m;

    # Compress JSON and text (the Qur'an reading and tajweed payloads are 150-500 kB uncompressed).
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml application/manifest+json;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;

    # Health probes (liveness/readiness) for uptime monitors.
    location = ${WOI_BASE_PATH}/api/health/live  { proxy_pass http://api:8000/health/live; }
    location = ${WOI_BASE_PATH}/api/health/ready { proxy_pass http://api:8000/health/ready; }

    # Credential endpoints get a tight burst limit on top of the application's own limiter.
    location ~ ^${WOI_BASE_PATH}/api/v1/auth/(login|register|forgot-password|reset-password)$ {
        limit_req zone=woi_auth burst=10 nodelay;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        rewrite ^${WOI_BASE_PATH}/api/(.*)$ /api/$1 break;
        proxy_pass http://api:8000;
    }

    # API: strip "${WOI_BASE_PATH}", forward "/api/v1/..." unchanged. Rate-limit per client address.
    location ${WOI_BASE_PATH}/api/ {
        limit_req zone=woi_api burst=60 nodelay;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        proxy_pass http://api:8000/api/;
    }

    # Web app: forward the full path including the base path (Next.js basePath expects it).
    location ${WOI_BASE_PATH}/ {
        proxy_pass http://web:3000;
    }
    # Without this exact match nginx would auto-redirect "${WOI_BASE_PATH}" to "${WOI_BASE_PATH}/", which
    # Next.js then redirects back (trailing-slash normalisation): a redirect loop.
    location = ${WOI_BASE_PATH} {
        proxy_pass http://web:3000;
    }

    location / { return 404; }
}

map $http_upgrade $connection_upgrade { default upgrade; '' close; }
