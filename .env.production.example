# Production environment for https://app.arfaat.com/worldofislam
# Copy to .env.production, replace EVERY CHANGE_ME, and keep the file out of Git (it is git-ignored).
# Generate secrets with:  openssl rand -hex 32     (use URL-safe values; hex is safe inside connection strings)

# ---- Public address -------------------------------------------------------------------------
WOI_PUBLIC_HOST=app.arfaat.com
WOI_BASE_PATH=/worldofislam
# Browser-visible API root: <public origin><base path>. The web app appends /api/v1 itself.
NEXT_PUBLIC_WOI_API_ORIGIN=https://app.arfaat.com/worldofislam

# ---- API ------------------------------------------------------------------------------------
WOI_ENVIRONMENT=production
WOI_LOG_LEVEL=INFO
WOI_ALLOWED_ORIGINS=https://app.arfaat.com
WOI_SECRET_KEY=CHANGE_ME_64_hex_chars
WOI_COOKIE_SECURE=true
WOI_COOKIE_PATH=/worldofislam
WOI_ROOT_PATH=
WOI_AUTH_RATE_LIMIT=10
# nginx's fixed address on the private edge network (see docker-compose.prod.yml). Never "*".
WOI_FORWARDED_ALLOW_IPS=172.31.200.10

# ---- PostgreSQL (password must match in both places) ---------------------------------------
POSTGRES_DB=world_of_islam
POSTGRES_USER=world_of_islam
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
WOI_DATABASE_URL=postgresql+asyncpg://world_of_islam:CHANGE_ME_postgres_password@postgres:5432/world_of_islam

# ---- Redis ----------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password
WOI_REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
WOI_CELERY_BROKER_URL=redis://:CHANGE_ME_redis_password@redis:6379/1
WOI_CELERY_RESULT_BACKEND=redis://:CHANGE_ME_redis_password@redis:6379/2

# ---- MinIO (private object storage) --------------------------------------------------------
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8_chars
WOI_S3_ENDPOINT=http://minio:9000
WOI_S3_ACCESS_KEY=CHANGE_ME_minio_user
WOI_S3_SECRET_KEY=CHANGE_ME_minio_password_min_8_chars
WOI_S3_BUCKET=world-of-islam

# ---- AI (local Ollama only; external providers stay OFF) -----------------------------------
WOI_AI_MODE=local
WOI_EXTERNAL_AI_ENABLED=false
WOI_OLLAMA_BASE_URL=http://ollama:11434
WOI_OLLAMA_MODEL=llama3.1
WOI_OLLAMA_TIMEOUT_SECONDS=60

# ---- Backups --------------------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
